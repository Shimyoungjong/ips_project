# IPS 프로젝트 환경변수 샘플
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채우고 셸에 export 하세요.
#   cp .env.example .env
#   set -a; source .env; set +a
#
# 모든 값은 선택 사항입니다. 지정하지 않으면 아래 주석의 기본값과
# 동일하게(= 기존 동작과 같게) 동작합니다.
# ⚠️ 실제 SSH 키 파일이나 비밀값은 저장소에 커밋하지 마세요. .env 는 .gitignore 대상입니다.

# 프로젝트 루트 (DB·모델·캡처·증거·로그·rules.json 기준 경로)
# 기본값: ~/ips_project
IPS_HOME=

# Ubuntu VM 접속용 SSH 개인키 경로
# 기본값: ~/.ssh/id_ed25519
IPS_SSH_KEY=

# Ubuntu VM 호스트(IP) — bridge100 고정 주소
# 기본값: 192.168.64.10
IPS_UBUNTU_HOST=

# Ubuntu SSH 사용자명
# 기본값: hisecure
IPS_UBUNTU_USER=

# Ubuntu에서 패킷을 캡처할 인터페이스 (ubuntu_agent.py) — 버전/설치마다 다르므로
# 우분투에서 `ip a`로 실제 인터페이스명을 확인하고 지정하세요.
# 기본값(start_demo.sh): enp0s1
IPS_UBUNTU_IFACE=

# Mac에서 패킷을 캡처할 인터페이스 (realtime_detect.py의 ScapyFlowCollector)
# 실제 공격 트래픽이 지나가는 인터페이스로 지정 (핫스팟/유선 등 환경에 따라 다름)
# 기본값: en0
IPS_IFACE=

# 시연/실행 스크립트가 백엔드(uvicorn) 실행에 사용할 Python 실행 파일
# 기본값(start_demo.sh): 프로젝트 자체 .venv (예: <IPS_HOME>/.venv/bin/python)
# ※ 예전엔 cicflowmeter 실행용 별도 conda 환경이 필요했지만, 지금은
#   ScapyFlowCollector가 패킷을 직접 캡처해서 cicflowmeter 자체가 필요 없습니다.
IPS_PYTHON=

# --- 시연 공격 스크립트 전용 (demo_full.command) ---
# 네트워크마다 바뀌므로 실행 환경에 맞게 지정 권장
# Ubuntu 취약 서버 IP (기본값: 192.168.45.6)
IPS_ATTACK_TARGET=
# Mac 공격자 IP (기본값: 192.168.45.135)
IPS_ATTACK_SRC=

# --- Ubuntu 측 패치 스크립트 전용 (patch_detect.py) ---
# 대상 app.py 경로 (기본값: /root/ips_project/vulnerable_server/app.py)
IPS_TARGET_APP=
